ndel_ar_over": 0.38461538461538464, "snitt_spearman": -0.04248694006185687, "antal_ar": 13, "antal_observationer": 1509, "profil": "sammansatt_utan_rapport", "protokoll": "2.0-pit-observationer", "begransningar": ["Dagens universum: överlevnadsbias kvarstår", "USA; inte validerat för svenska bolag", "Aktieantal mellan rapport och värderingsdag är en approximation; ADR och omräknade aktieantal kräver särskild kontroll"], "med_rapportsignaler": false, "nollkontroll": {"antal_omgangar": 300, "slump_snitt": 0.001694777987992761, "slump_std": 0.029627259285495002, "slump_p95": 0.04953892034394741, "slump_p99": 0.07882630795047425, "verkligt": -0.028437425793966995, "percentil": 14.333333333333334, "p_varde": 0.8566666666666667}, "dom": {"krav": [{"krav": "Toppfemtedelen slog universumet i snitt", "uppfyllt": false, "varde": "-2.8 %-enheter/år"}, {"krav": "Slog universumet fler år än inte", "uppfyllt": false, "varde": "38 % av 13 år"}, {"krav": "Toppfemtedelen slog bottenfemtedelen", "uppfyllt": false, "varde": "25.9 % mot 41.5 %"}, {"krav": "Positiv rangkorrelation mellan poäng och utfall", "uppfyllt": false, "varde": "Spearman -0.042"}, {"krav": "Utanför vad slumpen ger (p < 0,05)", "uppfyllt": false, "varde": "p = 0.857, percentil 14"}], "godkand": false, "text": "Modellen föll på: Toppfemtedelen slog universumet i snitt; Slog universumet fler år än inte; Toppfemtedelen slog bottenfemtedelen; Positiv rangkorrelation mellan poäng och utfall; Utanför vad slumpen ger (p < 0,05). Poängen ska då läsas som en STRUKTURERAD SAMMANFATTNING av bolagens siffror, inte som en prognos. Den är fortfarande användbar för att hitta bolag att läsa på om — men den har inte visat att den kan rangordna framtida avkastning. OBS: bottenfemtedelen slog också universumet (41.5 % mot 28.8 %). Både högt och lågt betyg gick bättre än mitten — det ser mer ut som att modellen plockar ut bolag som RÖR SIG mycket än bolag som går bra. Explorativt test: dagens bolagsurval och upprepade modellförsök medför bias. Ingen oberoende bekräftelse av framtida avkastning."}, "tid": "2026-09-08T09:23:22+02:00"}